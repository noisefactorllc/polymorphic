{
  "name": "polymorphic",
  "version": "0.11",
  "description": "Polymorphic - Live shader coding environment using the Noisemaker DSL",
  "private": true,
  "scripts": {
    "start": "npm run build && node scripts/serve-book.mjs 3000",
    "dev": "npm run build && node scripts/serve-book.mjs 3000",
    "build": "node scripts/build-book.mjs",
    "book:extract": "node scripts/extract-book-data.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs && node scripts/check-book-params.mjs",
    "test:e2e": "playwright test",
    "test": "node --test tests/unit/*.test.mjs && node scripts/check-book-params.mjs",
    "check:links": "node scripts/check-book-links.mjs",
    "check:params": "node scripts/check-book-params.mjs"
  },
  "author": "Noise Factor",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.60.0",
    "serve": "^14.2.0"
  }
}
